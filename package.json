{
	"name": "my-harness",
	"version": "0.1.0",
	"description": "A model-agnostic AI agent harness",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"my-code": "./src/cli/index.ts",
		"harness": "./src/cli/index.ts"
	},
	"scripts": {
		"dev": "bun run src/cli/index.ts",
		"typecheck": "bun x tsc --noEmit",
		"lint": "bun x @biomejs/biome check --write .",
		"test": "bun test",
		"build:binary": "bun run scripts/compile.ts",
		"build:all": "bun run scripts/compile.ts --all",
		"harness": "bun run src/cli/index.ts"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "latest"
	},
	"dependencies": {
		"chalk": "^5.4.0",
		"commander": "^13.0.0",
		"node-html-parser": "^9.0.1",
		"smol-toml": "^1.3.0",
		"yaml": "^2.9.0"
	}
}
